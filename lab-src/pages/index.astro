---
const title = 'MPSTEAM Lab';
const description = 'MPS Team CN 的实验项目与小游戏集合。';
const currentYear = new Date().getFullYear();
const mainSite = 'https://mpsteam.cn';
const labSite = 'https://lab.mpsteam.cn';

const navItems = [
  { text: '主页', href: `${mainSite}/` },
  { text: '关于我们', href: `${mainSite}/about` },
  { text: '加入社区', href: `${mainSite}/join` },
  { text: 'Wiki', href: 'https://wiki.mpsteam.cn/', external: true },
  { text: 'Lab', href: `${labSite}/`, active: true },
  { text: 'GitHub', href: 'https://github.com/mps-team-cn', external: true },
  { text: '友情链接', href: `${mainSite}/links` },
  { text: '联系我们', href: `${mainSite}/contact` },
];

const projects = [
  {
    title: '横线赛车经营赛',
    description:
      'XP/VB 风格的复古横线赛车经营小游戏。报名、起跑、升级配件，在简单规则里跑出更好的成绩。',
    href: 'race/',
    status: '可玩',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4fc08d" />
    <link rel="icon" type="image/png" href={`${mainSite}/favicon.png`} />
    <title>{title} - 实验项目集合</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="主导航">
      <div class="nav-inner">
        <a class="brand" href={`${mainSite}/`}>MPS Team CN</a>
        <div class="nav-links" aria-label="桌面导航">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={item.active ? 'active' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">MPS Team CN</p>
          <h1>MPSTEAM Lab</h1>
          <p class="lead">
            这里收纳主站之外的实验性页面、互动工具和小游戏。整体视觉延续 MPS Team CN
            主站，具体项目保留各自的玩法与风格。
          </p>
          <div class="actions" aria-label="主要操作">
            <a class="button primary" href="race/">进入横线赛车</a>
            <a class="button secondary" href={`${mainSite}/`}>返回主站</a>
          </div>
        </div>
      </section>

      <section class="project-section" aria-labelledby="projects-title">
        <div class="section-inner">
          <div class="section-heading">
            <h2 id="projects-title">实验项目</h2>
            <p>小项目会在这里集中展示，便于从 Lab 入口访问。</p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project-card">
                  <div class="card-topline">
                    <span>{project.status}</span>
                  </div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <a class="card-link" href={project.href}>打开项目</a>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <div class="footer-brand">MPS Team CN</div>
          <p>多意识体科普与社区</p>
        </div>
        <div>
          <h2>快速链接</h2>
          <ul>
            <li><a href={`${mainSite}/about`}>关于我们</a></li>
            <li><a href={`${mainSite}/join`}>加入社区</a></li>
            <li><a href={`${mainSite}/contact`}>联系我们</a></li>
            <li><a href="https://wiki.mpsteam.cn/">Wiki</a></li>
          </ul>
        </div>
        <div>
          <h2>联系方式</h2>
          <ul>
            <li><a href="mailto:contact@mpsteam.cn">contact@mpsteam.cn</a></li>
            <li><a href="mailto:support@mpsteam.cn">support@mpsteam.cn</a></li>
          </ul>
        </div>
      </div>
      <div class="copyright">© {currentYear} MPS Team CN. 保留所有权利。</div>
    </footer>
  </body>
</html>

<style>
  :root {
    --brand: #4fc08d;
    --brand-600: #3da576;
    --brand-hover: #5cd4a0;
    --accent: #8b9eff;
    --bg: #ffffff;
    --fg: #0f172a;
    --muted: #64748b;
    --surface: #f8fafc;
    --card: #ffffff;
    --border: #e2e8f0;
    --radius: 12px;
    --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 8px 24px rgba(79, 192, 141, 0.15);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141b23;
      --fg: #e7edf7;
      --surface: #1e2532;
      --card: #1e2532;
      --border: #2d3748;
      --muted: #94a3b8;
      --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
      --shadow-hover: 0 8px 24px rgba(79, 192, 141, 0.25);
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    color: var(--fg);
    background: var(--bg);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  body {
    min-height: 100vh;
    margin: 0;
    background: var(--bg);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .nav-inner {
    display: flex;
    width: min(100% - 32px, 1280px);
    height: 64px;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    color: var(--brand);
    font-size: 20px;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-links a {
    border-radius: 8px;
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    padding: 10px 12px;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links .active {
    background: var(--surface);
    color: var(--brand);
  }

  .hero {
    padding: 104px 0 112px;
  }

  .hero-inner,
  .section-inner {
    width: min(100% - 48px, 1152px);
    margin: 0 auto;
  }

  .hero-inner {
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--brand);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 24px;
    color: var(--fg);
    font-size: clamp(40px, 7vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .lead {
    max-width: 760px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 20px;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 40px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid transparent;
    padding: 12px 32px;
    font-size: 16px;
    font-weight: 500;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .button:hover {
    transform: scale(1.04);
  }

  .button.primary {
    background: var(--brand);
    color: #ffffff;
  }

  .button.primary:hover {
    background: var(--brand-hover);
  }

  .button.secondary {
    border-color: var(--border);
    color: var(--fg);
  }

  .button.secondary:hover {
    background: var(--surface);
  }

  .project-section {
    background: var(--surface);
    padding: 80px 0;
  }

  .section-heading {
    margin-bottom: 48px;
    text-align: center;
  }

  .section-heading h2 {
    margin-bottom: 16px;
    color: var(--fg);
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .section-heading p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }

  .project-card {
    min-height: 260px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 28px;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .project-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-4px);
  }

  .card-topline {
    display: flex;
    margin-bottom: 18px;
  }

  .card-topline span {
    border: 1px solid rgba(79, 192, 141, 0.35);
    border-radius: 999px;
    background: rgba(79, 192, 141, 0.1);
    color: var(--brand-600);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    padding: 7px 10px;
  }

  .project-card h3 {
    margin-bottom: 14px;
    color: var(--fg);
    font-size: 22px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .project-card p {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .card-link {
    color: var(--brand);
    font-size: 15px;
    font-weight: 700;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 48px 0 32px;
  }

  .footer-inner {
    display: grid;
    width: min(100% - 48px, 1280px);
    margin: 0 auto;
    gap: 32px;
    grid-template-columns: 1.4fr 1fr 1fr;
  }

  .footer-brand {
    margin-bottom: 16px;
    color: var(--brand);
    font-size: 20px;
    font-weight: 700;
  }

  .site-footer p,
  .site-footer a {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-footer h2 {
    margin-bottom: 16px;
    color: var(--fg);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }

  .site-footer ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .copyright {
    width: min(100% - 48px, 1280px);
    margin: 32px auto 0;
    border-top: 1px solid var(--border);
    padding-top: 32px;
    color: var(--muted);
    font-size: 14px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .nav-inner {
      height: auto;
      min-height: 64px;
      flex-wrap: wrap;
      padding: 14px 0;
    }

    .nav-links {
      width: 100%;
      flex-wrap: wrap;
      gap: 8px;
    }

    .nav-links a {
      padding: 9px 10px;
    }

    .hero {
      padding: 72px 0 84px;
    }

    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-inner,
    .section-inner,
    .footer-inner,
    .copyright {
      width: min(100% - 32px, 1280px);
    }

    .lead {
      font-size: 17px;
    }

    .actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .project-section {
      padding: 64px 0;
    }
  }
</style>
