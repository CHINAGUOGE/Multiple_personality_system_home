---
import '../styles/tokens.css';
import '../styles/theme.css';
import {
  generateSEOMeta,
  getOrganizationSchema,
  getWebSiteSchema,
  SITE_CONFIG,
  type SEOProps
} from '../utils/seo';

export interface Props extends Partial<SEOProps> {
  title: string;
  description?: string;
  structuredData?: object[];
}

const {
  title = 'MPS Team CN — 多意识体科普与社区',
  description = '我们提供面向大众与从业者的客观科普与社区导航，严谨而温暖。',
  canonical,
  ogImage,
  ogType = 'website',
  keywords,
  author,
  publishedTime,
  modifiedTime,
  noindex = false,
  structuredData = [],
} = Astro.props;

// 生成 SEO meta
const seo = generateSEOMeta({
  title,
  description,
  canonical: canonical || Astro.url.pathname,
  ogImage: ogImage || SITE_CONFIG.defaultOGImage,
  ogType,
  keywords,
  author,
  publishedTime,
  modifiedTime,
  noindex,
});

// 默认结构化数据
const defaultStructuredData = [
  getOrganizationSchema(),
  getWebSiteSchema(),
];

const allStructuredData = [...defaultStructuredData, ...structuredData];

// 生成完整的图片 URL
const fullOgImage = seo.ogImage.startsWith('http')
  ? seo.ogImage
  : `${SITE_CONFIG.url}${seo.ogImage}`;
const fullCanonical = seo.canonical?.startsWith('http')
  ? seo.canonical
  : `${SITE_CONFIG.url}${seo.canonical || Astro.url.pathname}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{seo.title}</title>
    <meta name="title" content={seo.title} />
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords} />
    {seo.author && <meta name="author" content={seo.author} />}
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={seo.ogType} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content={SITE_CONFIG.locale} />
    {seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
    {seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:url" content={fullCanonical} />
    <meta name="twitter:title" content={seo.twitterTitle} />
    <meta name="twitter:description" content={seo.twitterDescription} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:site" content={SITE_CONFIG.twitterHandle} />
    <meta name="twitter:creator" content={SITE_CONFIG.twitterHandle} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#6b7cff" />
    <meta name="msapplication-TileColor" content="#6b7cff" />

    <!-- Structured Data (JSON-LD) -->
    {allStructuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Preconnect to important domains -->
    <link rel="preconnect" href="https://wiki.mpsteam.cn" />
    <link rel="dns-prefetch" href="https://wiki.mpsteam.cn" />
  </head>
  <body class="min-h-screen">
    <slot />
  </body>
</html>
