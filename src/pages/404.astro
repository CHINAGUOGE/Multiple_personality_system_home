---
import Layout from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="页面未找到 — MPS Team CN">
  <Nav />

  <main class="flex min-h-[60vh] items-center justify-center py-20">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h1 class="mb-4 text-6xl font-bold" style="color: var(--brand)">404</h1>
      <h2 class="mb-6 text-3xl font-bold" style="color: var(--fg)">页面未找到</h2>
      <p class="mb-8 text-lg" style="color: var(--muted)">
        抱歉，您访问的页面不存在或已被移除。
      </p>
      <div class="flex justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-white"
          style="background: var(--brand)"
        >
          返回首页
        </a>
        <a
          href="https://wiki.mpsteam.cn/"
          class="inline-flex items-center justify-center rounded-xl border px-6 py-3"
          style="border-color: var(--border); color: var(--fg)"
        >
          访问 Wiki
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
