---
import Layout from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '联系我们', url: '/contact' },
];
---

<Layout
  title="联系我们"
  description="联系 MPS Team CN 团队。我们提供官方商务邮箱、社区反馈邮箱、GitHub 和 Wiki 等多种联系方式，欢迎任何形式的交流与反馈。"
  canonical="/contact"
  keywords={[
    '联系我们',
    '联系方式',
    '官方邮箱',
    'MPS Team CN',
    '商务合作',
    '反馈建议',
    '社区支持',
  ]}
  structuredData={[getBreadcrumbSchema(breadcrumbs)]}
>
  <Nav />
  <!-- Hero Section -->
  <section class="py-16" style="background: var(--surface)">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h1 class="text-4xl font-bold md:text-5xl" style="color: var(--fg)">联系我们</h1>
      <p class="mt-4 text-lg" style="color: var(--muted)">
        我们欢迎任何形式的交流与反馈
      </p>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Official Contact Email -->
        <div class="card p-8">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl" style="background: var(--brand); opacity: 0.1">
            <svg
              class="h-6 w-6"
              style="color: var(--brand)"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold" style="color: var(--fg)">官方联系邮箱</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
            用于商务合作、媒体采访、正式咨询等官方事务
          </p>
          <a
            href="mailto:contact@mpsteam.cn"
            class="mt-4 inline-block text-lg font-medium transition-colors hover:underline"
            style="color: var(--brand)"
          >
            contact@mpsteam.cn
          </a>
          <div class="mt-4 text-xs" style="color: var(--muted)">
            我们会在 1-3 个工作日内回复
          </div>
        </div>

        <!-- Support Email -->
        <div class="card p-8">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl" style="background: var(--accent); opacity: 0.1">
            <svg
              class="h-6 w-6"
              style="color: var(--accent)"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
              ></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold" style="color: var(--fg)">信息反馈邮箱</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
            用于内容建议、问题反馈、社区意见、技术支持等
          </p>
          <a
            href="mailto:support@mpsteam.cn"
            class="mt-4 inline-block text-lg font-medium transition-colors hover:underline"
            style="color: var(--accent)"
          >
            support@mpsteam.cn
          </a>
          <div class="mt-4 text-xs" style="color: var(--muted)">
            我们会尽快处理您的反馈
          </div>
        </div>

        <!-- GitHub -->
        <div class="card p-8">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl" style="background: var(--fg); opacity: 0.1">
            <svg class="h-6 w-6" style="color: var(--fg)" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
              ></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold" style="color: var(--fg)">GitHub</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
            通过 Issues 和 Discussions 与我们交流,也可以直接参与项目开发
          </p>
          <a
            href="https://github.com/mps-team-cn"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block text-lg font-medium transition-colors hover:underline"
            style="color: var(--fg)"
          >
            mps-team-cn
          </a>
        </div>

        <!-- Wiki -->
        <div class="card p-8">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl" style="background: var(--brand); opacity: 0.1">
            <svg
              class="h-6 w-6"
              style="color: var(--brand)"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h2 class="text-xl font-semibold" style="color: var(--fg)">知识库 Wiki</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
            查阅详细的科普内容、常见问题解答和社区资源
          </p>
          <a
            href="https://wiki.mpsteam.cn/"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block text-lg font-medium transition-colors hover:underline"
            style="color: var(--brand)"
          >
            访问 Wiki
          </a>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="card mt-8 p-8">
        <h2 class="text-xl font-semibold" style="color: var(--fg)">联系前请注意</h2>
        <ul class="mt-4 space-y-2 text-sm leading-relaxed" style="color: var(--muted)">
          <li class="flex gap-2">
            <span style="color: var(--brand)">•</span>
            <span>我们尊重每一位来信者,但无法保证回复所有邮件</span>
          </li>
          <li class="flex gap-2">
            <span style="color: var(--brand)">•</span>
            <span>如果是技术问题或功能建议,建议通过 GitHub Issues 反馈以便追踪</span>
          </li>
          <li class="flex gap-2">
            <span style="color: var(--brand)">•</span>
            <span>请使用礼貌、清晰的语言描述您的问题或建议</span>
          </li>
          <li class="flex gap-2">
            <span style="color: var(--brand)">•</span>
            <span>我们致力于维护一个友善、包容、基于证据的社区环境</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
