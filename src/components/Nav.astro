---
const navItems = [
  { text: '主页', href: '/' },
  { text: '关于我们', href: '/about' },
  { text: '加入社区', href: '/join' },
  { text: 'Wiki', href: 'https://wiki.mpsteam.cn/', external: true },
  { text: 'GitHub', href: 'https://github.com/mps-team-cn', external: true },
  { text: '友情链接', href: '/links' },
];
---

<nav class="border-b" style="border-color: var(--border); background: var(--bg)">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <div class="flex items-center">
        <a href="/" class="text-xl font-bold" style="color: var(--brand)">
          MPS Team CN
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-center space-x-4">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-surface"
                style="color: var(--fg)"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.text}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          type="button"
          class="rounded-md p-2"
          style="color: var(--fg)"
          aria-label="打开菜单"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden">
    <div class="space-y-1 px-2 pb-3 pt-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block rounded-md px-3 py-2 text-base font-medium"
            style="color: var(--fg)"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.text}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
