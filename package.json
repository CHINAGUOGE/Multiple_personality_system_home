{
  "name": "mpsteam-cn",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:lab": "astro build --config astro.config.lab.mjs && node scripts/inject-lab-analytics.mjs",
    "preview": "astro preview",
    "lint": "eslint . && prettier -c . && markdownlint **/*.md && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && prettier -w . && markdownlint -f **/*.md && stylelint \"src/**/*.css\" --fix",
    "check:links": "linkinator dist --recurse --silent",
    "check:a11y": "pa11y http://localhost:4321 --reporter text",
    "postbuild": "node scripts/postbuild.js || true"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "linkinator": "^6.1.2",
    "lucide-static": "^0.469.0",
    "markdownlint-cli": "^0.41.0",
    "pa11y": "^8.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.3"
  }
}
